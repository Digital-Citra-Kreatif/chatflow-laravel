{
  "name": "littleboy130491/chatflow-laravel",
  "description": "Conversational, chat-style forms for Laravel: form builder, visitor chat runtime, submissions inbox and email notifications.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "keywords": ["laravel", "forms", "conversational-forms", "chat", "form-builder"],
  "require": {
    "php": "^8.3",
    "ext-openssl": "*",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/mail": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/routing": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/view": "^13.0",
    "opis/json-schema": "^2.6"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": { "ChatFlow\\Laravel\\": "src/" },
    "files": ["src/helpers.php"]
  },
  "autoload-dev": {
    "psr-4": { "ChatFlow\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["ChatFlow\\Laravel\\ChatFlowServiceProvider"]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
