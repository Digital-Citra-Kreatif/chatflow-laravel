{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@chatflow/*": ["../resources/js/*"],
      "@imajiner/admin-sdk": ["sdk/index.ts"],
      "@imajiner/admin-sdk/ui": ["sdk/ui.ts"],
      "@imajiner/admin-sdk/vite": ["sdk/vite.ts"],
      "@wordpress/i18n": ["src/lib/i18n.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "sdk/**/*", "vite.config.ts", "vitest.config.ts"]
}
