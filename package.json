{
  "name": "chatflow-laravel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.16"
  },
  "scripts": {
    "build": "npm run build:admin && npm run build:runtime",
    "build:admin": "CFF_ENTRY=builder vite build -c vite.admin.config.ts && CFF_ENTRY=submissions vite build -c vite.admin.config.ts && node -e \"require('node:fs').copyFileSync('resources/css/admin-shim.css', 'dist/admin/admin-shim.css')\"",
    "build:runtime": "vite build && CFF_ENTRY=tracking vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@xyflow/react": "12.10.1",
    "libphonenumber-js": "1.13.15",
    "preact": "10.29.8",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.28",
    "@wordpress/components": "42.0.0",
    "@wordpress/data": "10.57.0",
    "@wordpress/element": "9.0.0",
    "@wordpress/i18n": "6.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
